[
  {
    "id": "01-minimal",
    "title": "Minimal Setup",
    "description": "Simplest possible viewer",
    "file": "01-minimal.html",
    "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Example 1 - Minimal ThreePresenter</title>\n  <link href=\"https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css\" rel=\"stylesheet\">\n  <link href=\"https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css\" rel=\"stylesheet\">\n  <style>\n    * { margin: 0; padding: 0; box-sizing: border-box; }\n    body { font-family: system-ui; }\n    #viewer { width: 100vw; height: 100vh; }\n  </style>\n</head>\n<body>\n  <div id=\"viewer\"></div>\n\n  <script type=\"importmap\">\n    {\n      \"imports\": {\n        \"three\": \"https://cdn.jsdelivr.net/npm/three@0.180.0/build/three.module.js\",\n        \"three/addons/\": \"https://cdn.jsdelivr.net/npm/three@0.180.0/examples/jsm/\"\n      }\n    }\n  </script>\n\n  <script type=\"module\">\n    import { ThreePresenter, StaticBaseUrlResolver } from '../dist/three-presenter.js';\n\n    const presenter = new ThreePresenter({ \n      mount: 'viewer',\n      fileUrlResolver: new StaticBaseUrlResolver('../assets')\n    });\n\n    presenter.loadScene({\n      models: [{ id: 'model', file: 'venus.glb' }]\n    });\n  </script>\n</body>\n</html>\n"
  },
  {
    "id": "02-all-controls",
    "title": "All UI Controls",
    "description": "Complete UI button set",
    "file": "02-all-controls.html",
    "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Example 2 - All UI Controls</title>\n  <link href=\"https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css\" rel=\"stylesheet\">\n  <link href=\"https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css\" rel=\"stylesheet\">\n  <style>\n    * { margin: 0; padding: 0; box-sizing: border-box; }\n    body { font-family: system-ui; background: #2c2c2c; }\n    #viewer { width: 100vw; height: 100vh; }\n  </style>\n</head>\n<body>\n  <div id=\"viewer\"></div>\n  <script type=\"importmap\">\n    {\n      \"imports\": {\n        \"three\": \"https://cdn.jsdelivr.net/npm/three@0.180.0/build/three.module.js\",\n        \"three/addons/\": \"https://cdn.jsdelivr.net/npm/three@0.180.0/examples/jsm/\"\n      }\n    }\n  </script>\n\n  <script type=\"module\">\n    import { ThreePresenter, DefaultUI, StaticBaseUrlResolver } from '../dist/three-presenter.js';\n\n    const presenter = new ThreePresenter({ \n      mount: 'viewer',\n      fileUrlResolver: new StaticBaseUrlResolver('../assets')\n    });\n    const ui = new DefaultUI(presenter);\n\n    presenter.loadScene({\n      models: [{ id: 'model', file: 'venus.glb', rotation: [-90, 0, 0] }],\n      environment: { showGround: true, background: '#2c2c2c' }\n    }).then(() => {\n      // Show all available UI buttons\n      ui.setButtonVisible('home', true);\n      ui.setButtonVisible('light', true);\n      ui.setButtonVisible('env', true);\n      ui.setButtonVisible('screenshot', true);\n      ui.setButtonVisible('camera', true);\n      ui.setButtonVisible('annotation', true);\n    });\n  </script>\n</body>\n</html>\n"
  },
  {
    "id": "03-ply-material",
    "title": "PLY + Custom Material",
    "description": "Material overrides for PLY",
    "file": "03-ply-material.html",
    "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Example 3 - PLY with Custom Material</title>\n  <link href=\"https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css\" rel=\"stylesheet\">\n  <link href=\"https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css\" rel=\"stylesheet\">\n  <style>\n    * { margin: 0; padding: 0; box-sizing: border-box; }\n    body { font-family: system-ui; background: #1a1a1a; }\n    #viewer { width: 100vw; height: 100vh; }\n  </style>\n</head>\n<body>\n  <div id=\"viewer\"></div>\n  <script type=\"importmap\">\n    {\n      \"imports\": {\n        \"three\": \"https://cdn.jsdelivr.net/npm/three@0.180.0/build/three.module.js\",\n        \"three/addons/\": \"https://cdn.jsdelivr.net/npm/three@0.180.0/examples/jsm/\"\n      }\n    }\n  </script>\n\n  <script type=\"module\">\n    import { ThreePresenter, DefaultUI, StaticBaseUrlResolver } from '../dist/three-presenter.js';\n\n    const presenter = new ThreePresenter({ \n      mount: 'viewer',\n      fileUrlResolver: new StaticBaseUrlResolver('../assets')\n    });\n    const ui = new DefaultUI(presenter);\n\n    presenter.loadScene({\n      models: [{\n        id: 'ply-model',\n        file: 'laurana50k.ply',\n        material: {\n          color: '#ff2244',\n          metalness: 0.2,\n          roughness: 0.7,\n          flatShading: false\n        }\n      }],\n      environment: { showGround: true, background: '#1a1a1a' }\n    }).then(() => {\n      ui.setButtonVisible('home', true);\n      ui.setButtonVisible('light', true);\n      console.log('✅ PLY loaded with custom red material');\n    }).catch(err => {\n      console.warn('Note: bunny.ply not found, trying venus.glb instead');\n      // Fallback to GLB if PLY not available\n      presenter.loadScene({\n        models: [{\n          id: 'fallback',\n          file: 'venus.glb',\n          material: { color: '#ff4444', metalness: 0.2, roughness: 0.7 }\n        }],\n        environment: { showGround: true, background: '#1a1a1a' }\n      }).then(() => {\n        ui.setButtonVisible('home', true);\n        ui.setButtonVisible('light', true);\n      });\n    });\n  </script>\n</body>\n</html>\n"
  },
  {
    "id": "04-scale-indicator",
    "title": "Scale Indicator",
    "description": "Ground plane with scale bar",
    "file": "04-scale-indicator.html",
    "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Scale Indicator Example</title>\n    <style>\n        body { margin: 0; overflow: hidden; }\n        #viewer { width: 100vw; height: 100vh; }\n    </style>\n</head>\n<body>\n    <div id=\"viewer\"></div>\n\n<script type=\"importmap\">\n    {\n      \"imports\": {\n        \"three\": \"https://cdn.jsdelivr.net/npm/three@0.180.0/build/three.module.js\",\n        \"three/addons/\": \"https://cdn.jsdelivr.net/npm/three@0.180.0/examples/jsm/\"\n      }\n    }\n  </script>\n\n    <script type=\"module\">\n        import { ThreePresenter, StaticBaseUrlResolver } from '../dist/three-presenter.js';\n\n        const container = document.getElementById('viewer');\n        const resolver = new StaticBaseUrlResolver('../assets');\n        const presenter = new ThreePresenter({ mount: container, fileUrlResolver: resolver });\n\n        // Load scene with ground and scale indicator\n        await presenter.loadScene({\n            models: [{ id: 'model', file: 'venus.glb' }],\n            environment: {\n                showGround: true,\n                scaleIndicator: {\n                    enabled: true,\n                    unit: 'meter',\n                    rulerSize: 1,\n                    posX: 0,\n                    posZ: 0\n                }\n            }\n        });\n    </script>\n</body>\n</html>\n"
  },
  {
    "id": "05-nexus",
    "title": "Nexus Multiresolution",
    "description": "Progressive streaming NXZ",
    "file": "05-nexus.html",
    "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Example 5 - Nexus Multiresolution</title>\n    <link href=\"https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css\" rel=\"stylesheet\">\n    <link href=\"https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css\" rel=\"stylesheet\">\n    <style>\n        * { margin: 0; padding: 0; box-sizing: border-box; }\n        body { font-family: system-ui; background: #1e1e2e; }\n        #viewer { width: 100vw; height: 100vh; }\n        #info h3 { font-size: 16px; margin-bottom: 8px; color: #89dceb; }\n        #info code { background: rgba(255,255,255,0.1); padding: 2px 5px; border-radius: 3px; font-size: 12px; }\n    </style>\n</head>\n<body>\n    <div id=\"viewer\"></div>\n    <script type=\"importmap\">\n        {\n            \"imports\": {\n                \"three\": \"https://cdn.jsdelivr.net/npm/three@0.180.0/build/three.module.js\",\n                \"three/addons/\": \"https://cdn.jsdelivr.net/npm/three@0.180.0/examples/jsm/\"\n            }\n        }\n    </script>\n\n    <script type=\"module\">\n        import { ThreePresenter, DefaultUI, StaticBaseUrlResolver } from '../dist/three-presenter.js';\n\n        const presenter = new ThreePresenter({ \n            mount: 'viewer',\n            fileUrlResolver: new StaticBaseUrlResolver('../assets')\n        });\n        const ui = new DefaultUI(presenter);\n\n        presenter.loadScene({\n            models: [{ id: 'venus-nexus', file: 'laurana.nxz' }],\n            environment: { showGround: true, background: '#1e1e2e' }\n        }).then(() => {\n            ui.setButtonVisible('home', true);\n            ui.setButtonVisible('light', true);\n            ui.setButtonVisible('fullscreen', true);\n            console.log('✅ Nexus model loaded - resolution adapts as you navigate');\n        }).catch(err => {\n            console.error('Failed to load Nexus model:', err);\n        });\n    </script>\n</body>\n</html>\n"
  },
  {
    "id": "06-iiif-manifest",
    "title": "IIIF-3D Manifest",
    "description": "Load from a IIIF Presentation API 4 manifest",
    "file": "06-iiif-manifest.html",
    "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Example 6 - IIIF-3D Manifest</title>\n  <link href=\"https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css\" rel=\"stylesheet\">\n  <link href=\"https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css\" rel=\"stylesheet\">\n  <style>\n    * { margin: 0; padding: 0; box-sizing: border-box; }\n    body { font-family: system-ui; }\n    #viewer { width: 100vw; height: 100vh; }\n  </style>\n</head>\n<body>\n  <div id=\"viewer\"></div>\n\n  <script type=\"importmap\">\n    {\n      \"imports\": {\n        \"three\": \"https://cdn.jsdelivr.net/npm/three@0.180.0/build/three.module.js\",\n        \"three/addons/\": \"https://cdn.jsdelivr.net/npm/three@0.180.0/examples/jsm/\"\n      }\n    }\n  </script>\n\n  <script type=\"module\">\n    import { ThreePresenter, parseIIIFManifest } from '../dist/three-presenter.js';\n\n    const MANIFEST_URL =\n      'https://raw.githubusercontent.com/IIIF/3d/main/manifests/1_basic_model_in_scene/model_origin.json';\n\n    const presenter = new ThreePresenter({ mount: 'viewer' });\n\n    const response = await fetch(MANIFEST_URL);\n    const manifest = await response.json();\n    const scene = parseIIIFManifest(manifest);\n\n    await presenter.loadScene(scene);\n  </script>\n</body>\n</html>\n"
  }
]
      "descriptionHtml": "Progressive streaming NXZ",
      "file": "05-nexus.html",
      "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Example 5 - Nexus Multiresolution</title>\n    <link href=\"https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css\" rel=\"stylesheet\">\n    <link href=\"https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css\" rel=\"stylesheet\">\n    <style>\n        * { margin: 0; padding: 0; box-sizing: border-box; }\n        body { font-family: system-ui; background: #1e1e2e; }\n        #viewer { width: 100vw; height: 100vh; }\n        #info h3 { font-size: 16px; margin-bottom: 8px; color: #89dceb; }\n        #info code { background: rgba(255,255,255,0.1); padding: 2px 5px; border-radius: 3px; font-size: 12px; }\n    </style>\n</head>\n<body>\n    <div id=\"viewer\"></div>\n    <script type=\"importmap\">\n        {\n            \"imports\": {\n                \"three\": \"https://cdn.jsdelivr.net/npm/three@0.180.0/build/three.module.js\",\n                \"three/addons/\": \"https://cdn.jsdelivr.net/npm/three@0.180.0/examples/jsm/\"\n            }\n        }\n    </script>\n\n    <script type=\"module\">\n        import { ThreePresenter, DefaultUI, StaticBaseUrlResolver } from '../dist/three-presenter.js';\n\n        const presenter = new ThreePresenter({ \n            mount: 'viewer',\n            fileUrlResolver: new StaticBaseUrlResolver('../assets')\n        });\n        const ui = new DefaultUI(presenter);\n\n        presenter.loadScene({\n            models: [{ id: 'venus-nexus', file: 'laurana.nxz' }],\n            environment: { showGround: true, background: '#1e1e2e' }\n        }).then(() => {\n            ui.setButtonVisible('home', true);\n            ui.setButtonVisible('light', true);\n            ui.setButtonVisible('fullscreen', true);\n            console.log('✅ Nexus model loaded - resolution adapts as you navigate');\n        }).catch(err => {\n            console.error('Failed to load Nexus model:', err);\n        });\n    </script>\n</body>\n</html>\n"
    },
    {
      "id": "06-iiif-manifest",
      "title": "IIIF-3D Manifest",
      "description": "Loads a scene from a **[IIIF Presentation API 4](https://iiif.io/api/3d/)** manifest using `parseIIIFManifest()`",
      "descriptionHtml": "Loads a scene from a <strong><a href=\"https://iiif.io/api/3d/\">IIIF Presentation API 4</a></strong> manifest using <code>parseIIIFManifest()</code>",
      "file": "06-iiif-manifest.html",
      "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Example 6 - IIIF-3D Manifest</title>\n  <link href=\"https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css\" rel=\"stylesheet\">\n  <link href=\"https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css\" rel=\"stylesheet\">\n  <style>\n    * { margin: 0; padding: 0; box-sizing: border-box; }\n    body { font-family: system-ui; }\n    #viewer { width: 100vw; height: 100vh; }\n  </style>\n</head>\n<body>\n  <div id=\"viewer\"></div>\n\n  <script type=\"importmap\">\n    {\n      \"imports\": {\n        \"three\": \"https://cdn.jsdelivr.net/npm/three@0.180.0/build/three.module.js\",\n        \"three/addons/\": \"https://cdn.jsdelivr.net/npm/three@0.180.0/examples/jsm/\"\n      }\n    }\n  </script>\n\n  <script type=\"module\">\n    import { ThreePresenter, parseIIIFManifest } from '../dist/three-presenter.js';\n\n    const MANIFEST_URL =\n      'https://raw.githubusercontent.com/IIIF/3d/main/manifests/1_basic_model_in_scene/model_origin.json';\n\n    const presenter = new ThreePresenter({ mount: 'viewer' });\n\n    const response = await fetch(MANIFEST_URL);\n    const manifest = await response.json();\n    const scene = parseIIIFManifest(manifest);\n\n    await presenter.loadScene(scene);\n  </script>\n</body>\n</html>\n"
    },
    {
      "id": "07-external-controls",
      "title": "External Controls",
      "description": "Two models loaded side-by-side, with external buttons that toggle each model's visibility independently",
      "descriptionHtml": "Two models loaded side-by-side, with external buttons that toggle each model&#39;s visibility independently",
      "file": "07-external-controls.html",
      "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Example 7 - External Controls</title>\n  <link href=\"https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css\" rel=\"stylesheet\">\n  <link href=\"https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css\" rel=\"stylesheet\">\n  <style>\n    * { margin: 0; padding: 0; box-sizing: border-box; }\n    body { font-family: system-ui; }\n    #viewer { width: 100vw; height: 100vh; }\n\n    #controls {\n      position: fixed;\n      top: 12px;\n      left: 12px;\n      display: grid;\n      grid-template-columns: auto auto auto;\n      align-items: center;\n      gap: 5px 6px;\n      z-index: 100;\n    }\n\n    .model-label {\n      color: #fff;\n      font-size: 13px;\n      font-family: system-ui;\n      text-shadow: 0 1px 3px rgba(0,0,0,0.8);\n      padding-right: 2px;\n    }\n\n    .toggle-btn {\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      gap: 5px;\n      padding: 5px 10px;\n      border: none;\n      border-radius: 6px;\n      background: rgba(30, 30, 30, 0.82);\n      color: #fff;\n      font-size: 13px;\n      cursor: pointer;\n      backdrop-filter: blur(4px);\n      transition: background 0.15s, opacity 0.15s;\n      user-select: none;\n    }\n\n    .toggle-btn:hover { background: rgba(30, 30, 30, 0.95); }\n\n    .toggle-btn.off {\n      opacity: 0.45;\n    }\n\n    .toggle-btn i {\n      font-size: 15px;\n    }\n  </style>\n</head>\n<body>\n  <div id=\"viewer\"></div>\n\n  <div id=\"controls\">\n    <span class=\"model-label\">Venus</span>\n    <button class=\"toggle-btn\" id=\"btn-venus-vis\"   title=\"Toggle visibility\"><i class=\"bi bi-eye\"></i></button>\n    <button class=\"toggle-btn\" id=\"btn-venus-bbox\"  title=\"Toggle bounding box\"><i class=\"bi bi-bounding-box\"></i></button>\n\n    <span class=\"model-label\">Bacchus</span>\n    <button class=\"toggle-btn\" id=\"btn-bacchus-vis\"  title=\"Toggle visibility\"><i class=\"bi bi-eye\"></i></button>\n    <button class=\"toggle-btn\" id=\"btn-bacchus-bbox\" title=\"Toggle bounding box\"><i class=\"bi bi-bounding-box\"></i></button>\n  </div>\n\n  <script type=\"importmap\">\n    {\n      \"imports\": {\n        \"three\": \"https://cdn.jsdelivr.net/npm/three@0.180.0/build/three.module.js\",\n        \"three/addons/\": \"https://cdn.jsdelivr.net/npm/three@0.180.0/examples/jsm/\"\n      }\n    }\n  </script>\n\n  <script type=\"module\">\n    import { ThreePresenter, StaticBaseUrlResolver } from '../dist/three-presenter.js';\n\n    const presenter = new ThreePresenter({\n      mount: 'viewer',\n      fileUrlResolver: new StaticBaseUrlResolver('../assets')\n    });\n\n    await presenter.loadScene({\n      models: [\n        { id: 'venus',   file: 'sphere_r1_000.ply',  origin: 'model_coord',  position: [ 0, 1, 0] },\n        { id: 'bacchus', file: 'sphere_r1_500.ply',  origin: 'model_coord',   position: [ 0, 1, 0] }\n      ],\n      environment: { showGround: true }\n    });\n\n    // --- Visibility toggle ---\n    function makeVisToggle(btnId, modelId) {\n      const btn = document.getElementById(btnId);\n      let visible = true;\n      btn.addEventListener('click', () => {\n        visible = !visible;\n        presenter.setModelVisibility(modelId, visible);\n        btn.classList.toggle('off', !visible);\n        btn.querySelector('i').className = visible ? 'bi bi-eye' : 'bi bi-eye-slash';\n      });\n    }\n\n    // --- Bounding box toggle ---\n    function makeBboxToggle(btnId, modelId) {\n      const btn = document.getElementById(btnId);\n      let shown = false;\n      btn.classList.add('off');\n      btn.addEventListener('click', () => {\n        shown = !shown;\n        presenter.setModelBoundingBoxVisible(modelId, shown);\n        btn.classList.toggle('off', !shown);\n      });\n    }\n\n    makeVisToggle('btn-venus-vis',    'venus');\n    makeVisToggle('btn-bacchus-vis',  'bacchus');\n    makeBboxToggle('btn-venus-bbox',  'venus');\n    makeBboxToggle('btn-bacchus-bbox','bacchus');\n  </script>\n</body>\n</html>\n"
    },
    {
      "id": "08-obj-textured",
      "title": "OBJ + MTL + Texture",
      "description": "Loads an OBJ model with external **MTL** and texture files from the smoke asset set",
      "descriptionHtml": "Loads an OBJ model with external <strong>MTL</strong> and texture files from the smoke asset set",
      "file": "08-obj-textured.html",
      "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Example 8 - OBJ + MTL + Texture</title>\n  <link href=\"https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css\" rel=\"stylesheet\">\n  <link href=\"https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css\" rel=\"stylesheet\">\n  <style>\n    * { margin: 0; padding: 0; box-sizing: border-box; }\n    body { font-family: system-ui; background: #202020; }\n    #viewer { width: 100vw; height: 100vh; }\n  </style>\n</head>\n<body>\n  <div id=\"viewer\"></div>\n\n  <script type=\"importmap\">\n    {\n      \"imports\": {\n        \"three\": \"https://cdn.jsdelivr.net/npm/three@0.180.0/build/three.module.js\",\n        \"three/addons/\": \"https://cdn.jsdelivr.net/npm/three@0.180.0/examples/jsm/\"\n      }\n    }\n  </script>\n\n  <script type=\"module\">\n    import { ThreePresenter, DefaultUI, StaticBaseUrlResolver } from '../dist/three-presenter.js';\n\n    const presenter = new ThreePresenter({\n      mount: 'viewer',\n      fileUrlResolver: new StaticBaseUrlResolver('../assets/smoke')\n    });\n    const ui = new DefaultUI(presenter);\n\n    await presenter.loadScene({\n      models: [\n        {\n          id: 'obj-sub',\n          file: 'sub.obj',\n          origin: 'model_center'\n        }\n      ],\n      environment: {\n        showGround: true,\n        background: '#202020',\n        headLightOffset: [20, 15]\n      }\n    });\n\n    ui.setButtonVisible('home', true);\n    ui.setButtonVisible('light', true);\n    ui.setButtonVisible('lightPosition', true);\n    ui.setButtonVisible('env', true);\n    ui.setButtonVisible('camera', true);\n    ui.setButtonVisible('fullscreen', true);\n\n    console.log('✅ OBJ + MTL + texture example loaded');\n  </script>\n</body>\n</html>\n"
    },
    {
      "id": "09-point-picking",
      "title": "Point Picking",
      "description": "Minimal picking workflow: enable picking mode and read picked 3D coordinates via `onPointPicked`",
      "descriptionHtml": "Minimal picking workflow: enable picking mode and read picked 3D coordinates via <code>onPointPicked</code>",
      "file": "09-point-picking.html",
      "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Example 9 - Point Picking</title>\n  <style>\n    body { margin: 0; font-family: system-ui; }\n    #viewer { width: 100vw; height: 100vh; }\n    #ui {\n      position: fixed;\n      top: 12px;\n      left: 12px;\n      z-index: 10;\n      background: rgba(255, 255, 255, 0.92);\n      padding: 8px;\n      border-radius: 8px;\n    }\n    #out { margin-top: 8px; font-size: 13px; white-space: pre-line; }\n  </style>\n</head>\n<body>\n  <div id=\"viewer\"></div>\n  <div id=\"ui\">\n    <button id=\"pick\" type=\"button\">Pick point</button>\n    <div id=\"out\">No point selected yet.</div>\n  </div>\n\n  <script type=\"importmap\">\n    {\n      \"imports\": {\n        \"three\": \"https://cdn.jsdelivr.net/npm/three@0.180.0/build/three.module.js\",\n        \"three/addons/\": \"https://cdn.jsdelivr.net/npm/three@0.180.0/examples/jsm/\"\n      }\n    }\n  </script>\n\n  <script type=\"module\">\n    import { ThreePresenter, StaticBaseUrlResolver } from '../dist/three-presenter.js';\n\n    const presenter = new ThreePresenter({\n      mount: 'viewer',\n      fileUrlResolver: new StaticBaseUrlResolver('../assets')\n    });\n    const annotations = [];\n    let pickId = 0;\n\n    const pick = document.getElementById('pick');\n    const out = document.getElementById('out');\n\n    pick.addEventListener('click', () => {\n      presenter.togglePickingMode();\n      pick.textContent = presenter.isPickingMode ? 'Picking: double-click model' : 'Pick point';\n    });\n\n    presenter.onPointPicked = (point) => {\n      pick.textContent = 'Pick point';\n      annotations.push({\n        id: `picked-${++pickId}`,\n        label: `Picked ${pickId}`,\n        type: 'point',\n        geometry: point\n      });\n      presenter.getAnnotationManager().render(annotations);\n      out.textContent = `Picked point:\\n[${point.map(v => v.toFixed(4)).join(', ')}]`;\n    };\n\n    await presenter.loadScene({\n      models: [{ id: 'model', file: 'venus.glb' }],\n      environment: { showGround: true }\n    });\n  </script>\n</body>\n</html>\n"
    }
  ]
}
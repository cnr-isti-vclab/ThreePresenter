      "file": "01-minimal.html",
      "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Example 1 - Minimal ThreePresenter</title>\n  <link href=\"https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css\" rel=\"stylesheet\">\n  <link href=\"https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css\" rel=\"stylesheet\">\n  <style>\n    * { margin: 0; padding: 0; box-sizing: border-box; }\n    body { font-family: system-ui; }\n    #viewer { width: 100vw; height: 100vh; }\n  </style>\n</head>\n<body>\n  <div id=\"viewer\"></div>\n\n  <script type=\"importmap\">\n    {\n      \"imports\": {\n        \"three\": \"https://cdn.jsdelivr.net/npm/three@0.180.0/build/three.module.js\",\n        \"three/addons/\": \"https://cdn.jsdelivr.net/npm/three@0.180.0/examples/jsm/\"\n      }\n    }\n  </script>\n\n  <script type=\"module\">\n    import { ThreePresenter, StaticBaseUrlResolver } from '../dist/three-presenter.js';\n\n    const presenter = new ThreePresenter({ \n      mount: 'viewer',\n      fileUrlResolver: new StaticBaseUrlResolver('../assets')\n    });\n\n    presenter.loadScene({\n      models: [{ id: 'model', file: 'venus.glb' }]\n    });\n  </script>\n</body>\n</html>\n"
    },
    {
